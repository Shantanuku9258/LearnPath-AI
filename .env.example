# LearnPath AI environment placeholders.
# Copy this file to .env and fill in local values.
# Never commit a real .env file or real credentials.

# --- MySQL 8.4 LTS (local Windows) ---
# Create the database and user in a privileged MySQL session first.
# This application will not CREATE DATABASE or DROP DATABASE.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=learnpath_app
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=learnpath_ai

# Optional SQLAlchemy URL override. If set, it takes precedence over MYSQL_*.
# Must use the PyMySQL driver. SQLite URLs are rejected.
# DATABASE_URL=mysql+pymysql://learnpath_app:change_me@127.0.0.1:3306/learnpath_ai

# Set to 1 only when a real MySQL 8.4 instance and .env credentials are ready.
LEARNPATH_MYSQL_IT=0

# --- Runtime ---
LEARNPATH_ENV=development
LEARNPATH_TZ=UTC
LEARNPATH_LOG_LEVEL=INFO

# --- Reproducibility ---
LEARNPATH_SEED=20261022
LEARNPATH_DATASET_PROFILE=dev


